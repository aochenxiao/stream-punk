prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: Check
Description: A unit test framework for C
URL: https://libcheck.github.io/check/
Version: 0.15.2
Requires.private: 
Libs: "-L${libdir}" -lcheck
Libs.private:  -pthread 
Cflags: "-I${includedir}" -pthread

